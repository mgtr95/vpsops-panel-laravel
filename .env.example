# Session signing is created automatically on first start (stored in the data volume).
# Set this only if you want a specific value. Do not change it later unless you accept
# that stored mail passwords and GitHub App secrets must be saved again.
# SESSION_SECRET=

# ---------------------------------------------------------------------------
# Access (like Portainer / Woodpecker)
# ---------------------------------------------------------------------------
# You can also paste a panel domain in the dashboard Settings page (owner).
# That issues a Let's Encrypt cert through website hosting (nginx + certbot)
# and does not require changing this file.
#
# A) No domain — plain HTTP on the VPS IP:
#      PANEL_DOMAIN=
#      → http://YOUR_VPS_IP:9090
#
# B) Domain + automatic certificate (ports 80 & 443 must be free):
#      PANEL_DOMAIN=panel.example.com
#      ACME_EMAIL=you@example.com
#      PANEL_AUTO_HTTPS=true
#      docker compose -f docker-compose.yml -f docker-compose.https.yml up -d
#      → https://panel.example.com  (Caddy issues + renews Let's Encrypt)
#      Do not use this together with Websites nginx on 80/443.
#
# C) Domain but TLS terminates on your own nginx/traefik:
#      PANEL_DOMAIN=panel.example.com
#      PANEL_AUTO_HTTPS=false
#      → http://IP:9090 internally; your proxy handles HTTPS
# ---------------------------------------------------------------------------
PANEL_DOMAIN=
ACME_EMAIL=
PANEL_AUTO_HTTPS=
PANEL_PORT=9090

REQUIRE_2FA=true
SESSION_TTL_HOURS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Host mounts — leave blank to use compose defaults under ./.keep/
# HOST_APPS_DIR=/path/to/your/apps
# HOST_LETSENCRYPT_DIR=/etc/letsencrypt
# HOST_SSH_DIR=/home/YOUR_USER/.ssh
# HOST_GITCONFIG=/home/YOUR_USER/.gitconfig

TZ=UTC

COMPOSE_SCAN_PATHS=/apps

# Optional overrides if you already run nginx/certbot (the panel auto-detects otherwise)
# CERTBOT_CONTAINER=
# NGINX_CONTAINER=
# NGINX_CONF_DIR=
# PROXY_NETWORK=

# GitHub App (optional — the panel can create one via Connect GitHub)
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=
